// Maximum Subarray ( Problem 1 )

class Solution {
    public int maxSubArray(int[] nums) {
        int sum = nums[0];
        int steal = nums[0];
        for(int i = 1; i < nums.length; i++) {
            sum = Math.max(nums[i], sum += nums[i]);
            steal = Math.max(sum, steal);   
        }
        return steal;
    }
}











// Contains Duplicate ( Problem 2 )

class Solution {
    public boolean containsDuplicate(int[] nums) {
        HashSet<Integer> set = new HashSet<>();
        for (int num : nums) {
            if (set.contains(num)) {
                return true;
            }
            set.add(num);
        }
        return false;
    }
}












// Maximum Average Subarray 1 ( Problem 3 )

class Solution {
    public double findMaxAverage(int[] nums, int k) {
        int l = 0;
        int r = 0;
        int maxAvg = Integer.MIN_VALUE;
        int sum = 0;
        while(r < nums.length) {
            sum += nums[r];
            if((r - l + 1) == k) {
                maxAvg = Math.max(sum, maxAvg);
                sum -= nums[l];
                l++;
            }
            r++;
        }
        return (double)maxAvg / k;
    }
}
