Abstract Class Compartment
abstract class Compartment {
    // abstract method
    public abstract String notice();
}


Derived Classes
FirstClass
class FirstClass extends Compartment {
    public String notice() {
        return "First Class Compartment: Comfortable journey with AC facilities.";
    }
}
Ladies
class Ladies extends Compartment {
    public String notice() {
        return "Ladies Compartment: Reserved for female passengers.";
    }
}
General
class General extends Compartment {
    public String notice() {
        return "General Compartment: Open for all passengers.";
    }
}
Luggage
class Luggage extends Compartment {
    public String notice() {
        return "Luggage Compartment: Used for carrying goods.";
    }
}


Test Class (Main Function)
import java.util.Random;

public class TestCompartment {
    public static void main(String[] args) {

        Compartment[] compartments = new Compartment[10];
        Random rand = new Random();

        for (int i = 0; i < 10; i++) {
            int r = rand.nextInt(4) + 1; // random number between 1 to 4

            switch (r) {
                case 1:
                    compartments[i] = new FirstClass();
                    break;
                case 2:
                    compartments[i] = new Ladies();
                    break;
                case 3:
                    compartments[i] = new General();
                    break;
                case 4:
                    compartments[i] = new Luggage();
                    break;
            }
        }

        // Polymorphism check
        for (int i = 0; i < 10; i++) {
            System.out.println("Compartment " + (i + 1) + ": " + compartments[i].notice());
        }
    }
}
